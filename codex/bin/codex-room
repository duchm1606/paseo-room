#!/usr/bin/env bash
set -euo pipefail

role="${1:?usage: codex-room <supervisor|lead|peer|peer-zen> [codex args...]}"
shift
case "$role" in
  supervisor|lead|peer|peer-zen) ;;
  *) printf 'invalid Codex Room role: %s\n' "$role" >&2; exit 2 ;;
esac

"${HOME}/.local/bin/codex-room-sync" "$role"
export CODEX_HOME="${HOME}/.codex-runtime/${role}"

# Codex reaches models through the local CLIProxyAPI custom provider. The key
# is read from the proxy config rather than copied here, so rotating it there
# is enough; an exported CLIPROXY_API_KEY wins (duckling-oci sets it in the
# daemon's systemd EnvironmentFile). Homebrew config on macOS, the upstream
# default location on Linux.
if [ -z "${CLIPROXY_API_KEY:-}" ]; then
  CLIPROXY_API_KEY="$(sed -n '/^api-keys:/,/^[A-Za-z#]/p' \
    /opt/homebrew/etc/cliproxyapi.conf "$HOME/.cli-proxy-api/config.yaml" 2>/dev/null |
    grep -oE '[A-Za-z0-9]{32,}' | head -1)"
  if [ -z "$CLIPROXY_API_KEY" ]; then
    printf 'codex-room: cannot read an api-key from cliproxyapi.conf; refusing to start %s without a CLIProxyAPI credential\n' "$role" >&2
    exit 3
  fi
fi
export CLIPROXY_API_KEY

# HISTORY. peer-zen and the now-deleted `review` role both talked straight to
# OpenCode Zen because CLIProxyAPI 7.2.120 dropped the SSE terminator events
# for gpt-5.6-luna and Codex then never finalised an item — the seat announced
# a tool call and silently never ran it. Measured 2026-08-08.
#
# 2026-09-10: RE-MEASURED, and the defect does not reproduce. Evidence, each
# layer with gpt-5.6-sol as a positive control because a live lane was running
# on it at the time:
#   chat/completions           luna http=200 'ok'      sol http=200 'ok'
#   chat/completions streaming luna [DONE] present     sol [DONE] present
#   /v1/responses              luna status=completed   sol status=completed
# luna answered 200 while the OpenCode Zen account was out of balance, which
# is what places it on the Codex OAuth credential rather than the Zen key.
#
# This is kept after the `review` role was deleted (owner directive
# 2026-09-12, OCR lane removed) because it is the only record that luna works
# over CLIProxyAPI. luna did not leave with the role — it is now a model on
# the `codex-peer` provider, reached through this same path, so the measurement
# still governs a live route.
#
# peer-zen is deliberately LEFT on the Zen branch and untouched: nothing uses
# it, its whole identity is "Zen direct", and routing it through CLIProxyAPI
# would only make it a confusing duplicate of codex-peer restricted to luna.
# It is a deletion candidate, not a re-route candidate — and that deletion is
# a separate owner decision, still open.
override=()
if [ "$role" = "peer-zen" ]; then
  zen_key="$(sed -n '/name: OpenCodeGo/,/models:/p' \
    /opt/homebrew/etc/cliproxyapi.conf 2>/dev/null |
    grep -oE 'sk-[A-Za-z0-9]+' | head -1)"
  if [ -z "$zen_key" ]; then
    printf 'codex-room: cannot read the OpenCode Zen key from cliproxyapi.conf; refusing to start %s on the broken CLIProxyAPI path\n' "$role" >&2
    exit 3
  fi
  export OPENCODE_ZEN_API_KEY="${OPENCODE_ZEN_API_KEY:-$zen_key}"
  override=(-c model_provider=zen)
fi

exec "$(command -v codex)" ${override[@]+"${override[@]}"} "$@"
