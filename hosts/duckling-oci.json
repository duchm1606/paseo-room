{
  "daemon": {
    "mcp": {
      "injectIntoAgents": true,
      "injectIntoProviders": [
        "lead",
        "supervisor"
      ]
    }
  },
  "pluginsEnabled": false,
  "plugins": {},
  "agents": {
    "providers": {
      "claude": {
        "label": "Claude",
        "description": "Base seat. Same delegation law as the role seats: Paseo seats are the only delegation surface, no in-session subagents.",
        "disallowedTools": [
          "Task",
          "Agent",
          "Workflow"
        ]
      },
      "opencode": {
        "enabled": false
      },
      "supervisor": {
        "extends": "claude",
        "label": "Supervisor-of-record",
        "description": "Governance front door, process memory, Paseo lifecycle",
        "command": [
          "@HOME@/.paseo/orchestration/bin/claude-supervisor"
        ],
        "env": {
          "ROOM_ROLE": "supervisor"
        },
        "models": [
          {
            "id": "claude-opus-5-5",
            "label": "Opus 5.5 (1M)"
          },
          {
            "id": "claude-opus-5",
            "label": "Opus 5 (1M)",
            "isDefault": true
          },
          {
            "id": "claude-opus-4-8[1m]",
            "label": "Opus 4.8 (1M)"
          },
          {
            "id": "claude-fable-5[1m]",
            "label": "Fable 5 (1M)"
          },
          {
            "id": "claude-fable-5",
            "label": "Fable 5 (200K)"
          },
          {
            "id": "claude-sonnet-5",
            "label": "Sonnet 5 (momentum/ops)"
          }
        ],
        "disallowedTools": [
          "Task",
          "Agent",
          "Workflow"
        ],
        "order": 1
      },
      "lead": {
        "extends": "claude",
        "label": "Lead-of-record",
        "description": "Router and binding arbiter — planning, coordination, acceptance",
        "command": [
          "@HOME@/.paseo/orchestration/bin/claude-lead"
        ],
        "env": {
          "ROOM_ROLE": "lead"
        },
        "models": [
          {
            "id": "claude-opus-5-5",
            "label": "Opus 5.5 (1M)"
          },
          {
            "id": "claude-opus-5",
            "label": "Opus 5 (1M)",
            "isDefault": true
          },
          {
            "id": "claude-opus-4-8[1m]",
            "label": "Opus 4.8 (1M)"
          }
        ],
        "disallowedTools": [
          "Task",
          "Agent",
          "Workflow"
        ],
        "order": 2
      },
      "peer": {
        "extends": "claude",
        "label": "Peer",
        "description": "Independent engineering peer; disposition (Engineer/Architect/Reviewer/Scout) set per task brief. Owner directive 2026-09-12: fast mode stays OFF on this seat too. Here it means the Claude toggle - a different feature from the Codex one on codex-peer, same id, and it was already off on every peer seat. Paseo exposes no provider key that hides it: the Claude provider surfaces it for any model whose manifest carries supportsFastMode, which is every Opus entry below. Dropping the Opus models is the only way to make the toggle disappear and the owner declined that, so the peer keeps Opus and this line is the record.",
        "command": [
          "@HOME@/.paseo/orchestration/bin/claude-peer"
        ],
        "models": [
          {
            "id": "claude-opus-5-5",
            "label": "Opus 5.5 (1M)",
            "isDefault": true
          },
          {
            "id": "claude-fable-5-1",
            "label": "Fable 5.1"
          },
          {
            "id": "claude-fable-5[1m]",
            "label": "Fable 5"
          },
          {
            "id": "claude-opus-5",
            "label": "Opus 5 (1M)"
          },
          {
            "id": "claude-opus-4-8[1m]",
            "label": "Opus 4.8 (1M)"
          },
          {
            "id": "claude-sonnet-5",
            "label": "Sonnet 5"
          }
        ],
        "disallowedTools": [
          "Task",
          "Agent",
          "Workflow",
          "mcp__paseo"
        ]
      },
      "codex-peer": {
        "extends": "codex",
        "label": "Codex Peer",
        "description": "Bounded engineering collaborator on CLIProxy-routed DeepSeek; no Paseo tools. duckling-oci runs CLIProxyAPI with OpenCodeGo/deepseek-v4.1-flash only, so this is the one model. codex-room reads CLIPROXY_API_KEY from the daemon environment (systemd EnvironmentFile ~/.config/cliproxy.env). deepseek-v4.1-flash is the declared default in BOTH this table and ~/.codex/peer.config.toml; keep those two in step. Fast mode stays off: do not pass featureValues.fast_mode to create_agent here.",
        "command": [
          "@HOME@/.local/bin/codex-room",
          "peer"
        ],
        "models": [
          {
            "id": "deepseek-v4.1-flash",
            "label": "DeepSeek V4.1 Flash",
            "isDefault": true,
            "thinkingOptions": [
              {
                "id": "high",
                "label": "High",
                "isDefault": true
              },
              {
                "id": "none",
                "label": "None"
              }
            ]
          }
        ],
        "disallowedTools": [
          "Task",
          "Agent",
          "Workflow",
          "mcp__paseo"
        ]
      },
      "pi": {
        "enabled": false
      },
      "copilot": {
        "enabled": false
      },
      "codex": {
        "additionalModels": [
          {
            "id": "deepseek-v4.1-flash",
            "label": "DeepSeek V4.1 Flash",
            "thinkingOptions": [
              {
                "id": "high",
                "label": "High",
                "isDefault": true
              },
              {
                "id": "none",
                "label": "None"
              }
            ]
          }
        ]
      }
    }
  }
}
