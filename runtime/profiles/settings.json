{
  "enabledPlugins": {
    "duck@swekit": false,
    "mattpocock-skills@mattpocock": false,
    "obsidian@obsidian-skills": false,
    "code-review@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false,
    "sentry@claude-plugins-official": false,
    "aikido@claude-plugins-official": false,
    "atlassian@claude-plugins-official": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task|Agent|Workflow|Skill|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.paseo/orchestration/hooks/role-gate.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.paseo/orchestration/hooks/inject-profile.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$HOME\"/.paseo/orchestration/hooks/telemetry.sh session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.paseo/orchestration/hooks/telemetry.sh pre-compact",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.paseo/orchestration/hooks/telemetry.sh stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
