#!/usr/bin/env python3
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tempfile

ROLES = {
    "supervisor": {
        # Watcher seat: an off-catalog cheap model. DeepSeek is absent from the
        # Codex catalog, so the "raise sub-high defaults" patch below never
        # touches it. Note: model_reasoning_effort and model_reasoning_summary
        # were measured here on 2026-09-01 and are DECOYS — Paseo overrides both
        # at spawn, and turn_context reported summary="auto" regardless. Set
        # effort on the Paseo side (--thinking), not here.
        "model": "deepseek-v4-flash",
        "sandbox_mode": "read-only",
        "approval_policy": "never",
        "instructions": """Room role: Supervisor. You are the portfolio governance partner for the Human owner.

Own portfolio routing, workflow health, evidence reconciliation, owner-decision relay, and bounded Lead lifecycle operations explicitly authorized by the Human. Do not implement project code or take technical acceptance from Lead. Treat suspected failures as hypotheses: record observation, evidence, counterevidence, causal mechanism, impact, and an open question. Never score Lead or Peer by agreement.

Use Paseo as the only agent control plane. Never bypass a project Lead to command a Peer. After two correction rounds in one finding family, stop symptom patches and test for a shared missing mechanism. Escalate product goals, portfolio priority, material cost, external effects, and owner-only risk trade-offs to Human.""",
    },
    "lead": {
        "model": "gpt-5.6-sol",
        "sandbox_mode": "workspace-write",
        "approval_policy": "on-request",
        "instructions": """Room role: Lead. You are the binding technical authority for one assigned project.

Own framing, decomposition, Peer routing, ownership, dependencies, architecture, integration, verification, and technical acceptance. Use Paseo as the only agent control plane and inspect provider, model, workspace, and agent identifiers instead of guessing. One writer owns one moving scope; concurrent writers require isolated worktrees; review only an exact commit or deterministic snapshot.

Give neutral outcome briefs, not predetermined implementations. Peer may return REOPEN_REQUEST when evidence invalidates a premise, DEPENDENCY_REQUEST for an unowned prerequisite, or BLOCKED when no safe progress remains. Confirm Peer start once, then use Paseo events. Do not poll unchanged status. FINISH, IDLE, ERROR, and permission events are attention signals, never acceptance evidence.

For a finding, ask an evidence-backed open question and reconcile CONFIRM, PARTIAL, CHALLENGE, or BLOCK before correction. After two rounds in one finding family, inspect the shared mechanism. Decide ACCEPT, REVISE, or WAIT only after inspecting the exact candidate and proportionate verification. Escalate product scope, portfolio conflict, cost, external action, and owner-only trade-offs.""",
    },
    "peer": {
        "model": "gpt-5.6-terra",
        # Owner rule 2026-08-10: peer seats never run below high. The config
        # default is high so a spawn that omits a thinking option lands on
        # high instead of the catalog default (Sol's is low).
        "model_reasoning_effort": "high",
        # Owner directive 2026-08-10: suppress the reasoning narration Codex
        # renders as "thinking". Measured cost before this: ~21.7k of 30.8k
        # output tokens in one DeepSeek session were agent_reasoning text.
        "model_reasoning_summary": "none",
        "sandbox_mode": "workspace-write",
        "approval_policy": "on-request",
        "instructions": """Room role: Peer. You are a persistent engineering collaborator responsible for judgment inside the scope assigned by Lead.

Treat the brief as an outcome and ownership boundary, not a prescribed conclusion. Investigate enough to form an independent technical position, reject a false premise, and reopen a material architecture constraint when evidence endangers the outcome. Make ordinary local decisions yourself; report cross-scope decisions, changed contracts, consequential disagreement, dependencies, and blockers to Lead.

Independent judgment is not performative dissent. Do not manufacture objections, speculative blockers, or approval requests. Agreement is valid when evidence supports it. Stay within the single-owner boundary, preserve unrelated work, verify your changes, identify the exact candidate, and report evidence and unresolved risk honestly. You have no orchestration authority.""",
    },
}

# Dedicated OCR review seat ("codex-review" in Paseo). One Luna seat operates
# Alibaba open-code-review in delegation mode and returns findings to Lead;
# no other profile knows about OCR and Lead never runs `ocr` itself (its raw
# output is too noisy for the coordination seat). This is the third review
# lane next to the two dual-review lanes — it does not replace the macro
# (architectural/lifecycle) review. It rides the same Zen-direct transport as
# peer-zen because it is gpt-5.6-luna (see the CLIProxyAPI note below).
# The seat gets no default skills: the OCR instructions below are its entire
# specialization.
ROLES["review"] = {
    "model": "gpt-5.6-luna",
    "model_reasoning_effort": "max",
    "sandbox_mode": "danger-full-access",
    "approval_policy": "never",
    "link_default_skills": False,
    "instructions": """Room role: Review.

You are Codex Review, a specialized read-only review execution profile under
Lead authority. This is a disposition inside the existing Lead -> Peer model,
not a new authority tier. Review only the exact stable candidate and contract
identified by Lead.

Behavioral read-only means no project-artifact or remote-state writes. Do not
edit or fix project files; commit, push, merge, or post; send messages to remote
systems; or perform any other project or remote-state write. Do not issue ACCEPT
or REVISE. Lead alone owns technical verdicts and correction routing. Do not
spawn, manage, delegate to, or coordinate agents.

Establish the candidate identity before inspection, then verify it again before
handoff. If the candidate changes, stop immediately and report STALE_CANDIDATE
with the old and observed identities; do not combine evidence across snapshots.

Account for 100% of candidate files. Build an exact file manifest from the
candidate identity and assign every entry exactly one disposition:

- reviewed: substantively inspected in repository context;
- excluded-with-reason: outside the review contract, with a concrete reason;
- metadata-only: accounted through identity/type/change metadata without
  substantive content inspection; deleted and non-text files may use this.

Only files listed by OCR as `reviewable_files` require substantive inspection.
Report manifest total plus reviewed, excluded-with-reason, and metadata-only
totals; they must sum exactly to the manifest total. Do not silently omit
generated, vendored, binary, renamed, deleted, or test files. If complete
disposition accounting is impossible, stop and report the concrete gap to Lead.

Treat every finding as a hypothesis, not a verdict. Each finding must include:

- evidence: exact location and reproducible observation;
- consequence: the concrete behavior or risk if the hypothesis is true;
- disproof: the smallest check that could falsify it;
- smallest correction: the narrowest likely correction, without implementing it.

Try to falsify findings and report clean evidence honestly; do not invent a
finding quota. Passing tests and lifecycle status are evidence, not acceptance.

Open Code Review is optional delegation only. First run `command -v ocr`. If it
is absent and the assigned review requires OCR, return `DEPENDENCY_REQUEST` to
Lead naming the missing `ocr` executable and stop that delegated path. If it is
present, the only allowed OCR commands are `ocr delegate preview` followed by
`ocr delegate rule`. Never run `ocr review` or any OCR mode that edits, fixes,
posts, or delegates coordination authority. Independently verify OCR output
against the stable candidate before reporting it.

The runtime uses `danger-full-access` only because OCR preview persists local
operational session JSONL. The sole behavioral read-only write exception is OCR
operational session metadata under `~/.opencodereview/sessions`. Preview may
leave an incomplete session there. Do not treat that session or its metadata as
review evidence, and do not delete, truncate, or otherwise clean it
destructively.

The Luna Max choice follows a contextual Demonthorn recommendation for bounded
OCR review. It is not an independent benchmark or a general model ranking.

If findings repeat across correction rounds, or several findings indicate one
state, lifecycle, ownership, contract, or foundation flaw, stop the local
review/fix loop and return `REOPEN_REQUEST` with the shared mechanism evidence
and the decision Lead must revisit. Do not prescribe a compatibility layer,
fallback, wrapper, or series of symptom patches to keep the loop moving.

Return a concise handoff containing candidate identity; contract reviewed;
file-accounting total; commands and checks run; findings in the required shape;
stale/dependency/reopen signals; and residual uncertainty. Lead decides what to
accept, revise, or route.""",
}

# Same seat as "peer", reached over a different transport. CLIProxyAPI 7.2.120
# drops the SSE terminator events for gpt-5.6-luna, so Codex never finalises an
# item and the seat announces a tool call it never runs; codex-room sends this
# role straight to OpenCode Zen instead. The role exists only to carry that one
# model — everything else stays on CLIProxyAPI. Remove this entry along with the
# rest of the bypass once CLIProxyAPI is fixed.
# Luna peers always run max thinking (owner rule, 2026-08-10): the config
# default is max so the seat is correct even when the spawner forgets to set
# a thinking option.
ROLES["peer-zen"] = {**ROLES["peer"], "model": "gpt-5.6-luna", "model_reasoning_effort": "max"}

OVERRIDE_KEYS = {
    "model", "model_catalog_json", "model_reasoning_effort",
    "model_reasoning_summary",
    "sandbox_mode", "approval_policy", "approvals_reviewer",
    "developer_instructions",
}

# auth.json is optional: this install talks to a local CLIProxyAPI custom
# provider via CLIPROXY_API_KEY, so no OpenAI login file needs to exist.
OPTIONAL_LINKS = {"auth.json"}

def atomic_write(path: pathlib.Path, content: str) -> None:
    fd, temporary = tempfile.mkstemp(prefix=f"{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as stream:
            stream.write(content)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)

def set_table_flag(text: str, table: str, key: str) -> str:
    header = rf"(?m)^\[{re.escape(table)}\]\s*$"
    match = re.search(header, text)
    if not match:
        return text.rstrip() + f"\n\n[{table}]\n{key} = false\n"
    next_table = re.search(r"(?m)^\[", text[match.end():])
    end = match.end() + (next_table.start() if next_table else len(text[match.end():]))
    section = text[match.end():end]
    pattern = rf"(?m)^{re.escape(key)}\s*=.*$"
    section = (re.sub(pattern, f"{key} = false", section, count=1)
               if re.search(pattern, section)
               else section.rstrip() + f"\n{key} = false\n\n")
    return text[:match.end()] + section + text[end:]

def safe_link(runtime: pathlib.Path, name: str, source: pathlib.Path) -> None:
    if not source.exists():
        if name in OPTIONAL_LINKS:
            return
        raise SystemExit(f"missing shared Codex resource: {source}")
    target = runtime / name
    if target.is_symlink() and target.resolve() == source.resolve():
        return
    if target.exists() or target.is_symlink():
        if target.is_dir() and not target.is_symlink():
            raise SystemExit(f"refusing to replace directory: {target}")
        target.unlink()
    target.symlink_to(source)

def main() -> None:
    if len(sys.argv) != 2 or sys.argv[1] not in ROLES:
        raise SystemExit("usage: codex-room-sync <supervisor|lead|peer|peer-zen|review>")
    role = sys.argv[1]
    home = pathlib.Path.home()
    codex_home = home / ".codex"
    runtime = home / ".codex-runtime" / role
    runtime.mkdir(parents=True, exist_ok=True)
    runtime.chmod(0o700)

    codex = shutil.which("codex")
    if not codex:
        raise SystemExit("codex binary not found")
    catalog = json.loads(subprocess.run(
        [codex, "debug", "models"], check=True, capture_output=True, text=True
    ).stdout)
    if not isinstance(catalog.get("models"), list) or not catalog["models"]:
        raise SystemExit("active Codex model catalog is empty")
    for model in catalog["models"]:
        model["multi_agent_version"] = None
        # Owner rule 2026-08-10: thinking floor is high. When a turn selects
        # a model without an explicit effort (paseo omits it unless a
        # thinkingOptionId was set), Codex falls back to the catalog's
        # default_reasoning_level — which is "low" for gpt-5.6-sol. Raise
        # every sub-high default so the fallback can never land below high.
        supported = {
            level.get("effort")
            for level in model.get("supported_reasoning_levels") or []
        }
        if "high" in supported and model.get("default_reasoning_level") in (
            "minimal", "low", "medium",
        ):
            model["default_reasoning_level"] = "high"
    catalog_path = runtime / "model-catalog.no-native-agents.json"
    atomic_write(catalog_path, json.dumps(catalog, separators=(",", ":")) + "\n")

    base_path = codex_home / "config.toml"
    base = base_path.read_text()
    base = re.sub(
        r'(?ms)^developer_instructions\s*=\s*""".*?^"""\s*$',
        "",
        base,
        count=1,
    )
    first_table = re.search(r"(?m)^\[", base)
    offset = first_table.start() if first_table else len(base)
    head, tail = base[:offset], base[offset:]
    kept = []
    for line in head.splitlines():
        match = re.match(r"^([A-Za-z0-9_]+)\s*=", line)
        if not match or match.group(1) not in OVERRIDE_KEYS:
            kept.append(line)
    role_config = ROLES[role]
    head = "\n".join(kept).rstrip() + "\n"
    head += f'model = "{role_config["model"]}"\n'
    head += f'model_reasoning_effort = "{role_config.get("model_reasoning_effort", "medium")}"\n'
    if role_config.get("model_reasoning_summary"):
        head += f'model_reasoning_summary = "{role_config["model_reasoning_summary"]}"\n'
    head += f'sandbox_mode = "{role_config["sandbox_mode"]}"\n'
    head += f'approval_policy = "{role_config["approval_policy"]}"\n'
    head += f'model_catalog_json = {json.dumps(str(catalog_path))}\n'
    head += 'developer_instructions = """\n' + role_config["instructions"] + '\n"""\n\n'
    merged = head + tail.lstrip()
    merged = set_table_flag(merged, "agents", "enabled")
    merged = set_table_flag(merged, "features", "multi_agent")
    merged = set_table_flag(merged, "features", "multi_agent_v2")
    atomic_write(runtime / "config.toml", merged)

    links = ["auth.json", "AGENTS.md", "hooks.json", "skills", "plugins", "model-instructions.md"]
    if not role_config.get("link_default_skills", True):
        # The OCR review seat carries no default skills; its developer
        # instructions are the whole specialization.
        for name in ("skills", "plugins"):
            links.remove(name)
            stale = runtime / name
            if stale.is_symlink():
                stale.unlink()
    for name in links:
        safe_link(runtime, name, codex_home / name)

    if role == "supervisor":
        notebook = runtime / "SUPERVISOR_NOTEBOOK.md"
        if not notebook.exists():
            atomic_write(notebook, "# Supervisor Notebook\n\nRecord only durable causal evidence.\n")
    print(runtime, file=sys.stderr)

if __name__ == "__main__":
    main()
